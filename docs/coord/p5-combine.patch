+/// `BRECCIA_POOL_COMBINE=1`: per-token callers post to the pool's queue and the
+/// lock holder runs every queued request in one phase pair (coord plan Phase 5).
+pub fn pool_combine_on() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("BRECCIA_POOL_COMBINE").is_ok_and(|v| v == "1"))
+}
+
+/// One queued per-token request: owned, because the thread that runs it is
+/// whichever caller holds the pool lock.
+struct TopkReq {
+    plan: LayerPlan,
+    ids: Vec<usize>,
+    weights: Vec<f32>,
+    x: Arc<Vec<f32>>,
+    /// Starts as the caller's `out`; the routed sum is added to it.
+    out: Vec<f32>,
+}
+
+impl TopkReq {
+    fn new(plan: &LayerPlan, ids: &[usize], weights: &[f32], x: &[f32], out: &[f32]) -> Self {
+        Self {
+            plan: *plan,
+            ids: ids.to_vec(),
+            weights: weights.to_vec(),
+            x: Arc::new(x.to_vec()),
+            out: out.to_vec(),
+        }
+    }
+}
+
+/// Where a combined request's result lands (filled under the pool lock).
+type ReplySlot = Arc<std::sync::Mutex<Option<std::result::Result<Vec<f32>, String>>>>;
+
+/// Requests posted but not yet run, shared by every caller of one pool.
+#[derive(Default)]
+pub struct CombineQueue {
+    pending: std::sync::Mutex<Vec<(TopkReq, ReplySlot)>>,
+}
+
+/// [`ExpertPool::moe_topk`] through the combining queue: post the request, take
+/// the pool lock, and either find it already run by the previous holder or run
+/// it together with everything else queued. Returns `(bytes, seconds spent
+/// before this caller's request started or was found done)`.
+///
+/// No request is lost: it is queued before the lock is taken, and a holder
+/// fills every slot it drained before it releases the lock, so a caller that
+/// finds its slot empty under the lock still has its request in the queue.
+pub fn moe_topk_combined(
+    pool: &std::sync::Mutex<ExpertPool>,
+    queue: &CombineQueue,
+    plan: &LayerPlan,
+    ids: &[usize],
+    weights: &[f32],
+    x: &[f32],
+    out: &mut [f32],
+) -> Result<(usize, f64)> {
+    if ids.len() != weights.len() {
+        bail!("{} expert ids vs {} weights", ids.len(), weights.len());
     }
+    if ids.is_empty() {
+        return Ok((0, 0.0));
+    }
+    let bytes = plan.expert_kernel_bytes() * ids.len();
+    let slot: ReplySlot = Arc::default();
+    let t0 = Instant::now();
+    queue
+        .pending
+        .lock()
+        .expect("the combine queue's lock")
+        .push((TopkReq::new(plan, ids, weights, x, out), Arc::clone(&slot)));
+    let mut guard = pool.lock().expect("the expert pool's lock");
+    let waited = t0.elapsed().as_secs_f64();
+    let reply = slot.lock().expect("a combine slot").take();
+    let reply = match reply {
+        Some(r) => r,
+        None => {
+            let drained = std::mem::take(&mut *queue.pending.lock().expect("the combine queue's lock"));
+            let (mut reqs, slots): (Vec<TopkReq>, Vec<ReplySlot>) = drained.into_iter().unzip();
+            let run = guard.moe_topk_many(&mut reqs).map_err(|e| format!("{e:#}"));
+            for (req, s) in reqs.into_iter().zip(&slots) {
+                *s.lock().expect("a combine slot") = Some(run.clone().map(|()| req.out));
+            }
+            slot.lock()
+                .expect("a combine slot")
+                .take()
+                .context("combined request was not in the drained queue")?
+        }
+    };
+    drop(guard);
+    let values = reply.map_err(|e| anyhow::anyhow!("combined expert lane: {e}"))?;
+    out.copy_from_slice(&values);
+    Ok((bytes, waited))
 }
 
