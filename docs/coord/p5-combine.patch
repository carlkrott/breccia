+/// The combining queue: four threads post different blocks' requests at once;
+/// whichever holds the lock runs them merged, and every result must be
+/// bit-identical to the single-threaded path.
+#[test]
+fn combined_pool_is_bit_identical_to_the_single_threaded_path() {
+    let Some(set) = open_model() else { return };
+    let layout = set.layout().expect("layout");
+    let plans: Vec<LayerPlan> = layout
+        .blocks()
+        .take(4)
+        .map(|b| LayerPlan::from_block(&set, b).expect("plan"))
+        .collect();
+    let pool = std::sync::Mutex::new(ExpertPool::new(Arc::clone(&set), 30, Path::Avx2));
+    let queue = pool.lock().unwrap().combine_queue();
+    std::thread::scope(|sc| {
+        for (t, plan) in plans.iter().enumerate() {
+            let (set, pool, queue) = (&set, &pool, &queue);
+            sc.spawn(move || {
+                let ids: Vec<usize> = (0..10).map(|j| (t * 31 + j * 47) % plan.n_experts).collect();
+                let weights: Vec<f32> = (1..=10).map(|j| 1.0 / (j as f32 * (3.0 + t as f32))).collect();
+                let x = fixed_x(plan.n_embd);
+                let mut want = vec![0f32; plan.n_embd];
+                moe_topk_sequential(set, Path::Avx2, plan, &ids, &weights, &x, &mut want)
+                    .expect("seq");
+                for round in 0..20 {
+                    let mut out = vec![0f32; plan.n_embd];
+                    moe_topk_combined(pool, queue, plan, &ids, &weights, &x, &mut out)
+                        .expect("combined");
+                    for (k, (a, b)) in out.iter().zip(&want).enumerate() {
+                        assert_eq!(a.to_bits(), b.to_bits(), "thread {t} round {round} element {k}");
+                    }
+                }
+            });
+        }
+    });
+}
