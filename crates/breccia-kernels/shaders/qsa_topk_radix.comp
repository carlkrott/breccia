#version 450
//
// QSA indexer top-k by radix select (upstream strata `block_topk_kernel` rule:
// radix threshold, ties to the lowest index, ids ascending).
//
// Same set and IDS/CNT contract as `qsa_topk.comp` (top `min(topk, visible)`
// blocks, ties to the lower index, the own block appended when missed), but
// emitted in ascending block order rather than descending score — the order only
// changes the attention's fp summation order. Scores are read, never written.
//
// One workgroup (1024 threads) per token. Every block whose score is above -1e29
// takes part (the same data-driven rule as the serial kernel: the
// -1e30 / -inf mask never enters the histogram). Up to 3 passes of 11/11/10 bits
// over an order-preserving uint key; a pass stops early when the chosen bin is
// taken whole. A decode call is one token = one workgroup on one CU, so the
// passes keep 4 loads in flight per thread and the bin search is a parallel scan
// (256 threads + a serial 256-bin search by thread 0 cost ~250 us per call at
// 51200 blocks; this is the whole 200k decode loss, tiered-context note 11-11). Emission: each thread owns a
// contiguous run of blocks, a shared-memory scan gives its output offset (no
// subgroup ops, so wave32 RDNA and wave64 GCN behave the same).

layout(local_size_x = 1024) in;

layout(std430, binding = 0) readonly buffer Scores { float SC[]; }; // [T, n_blocks]
layout(std430, binding = 1) writeonly buffer Ids { uint IDS[]; };   // [T, max_ids]
layout(std430, binding = 2) writeonly buffer Cnt { uint CNT[]; };   // [T]

layout(push_constant) uniform Params {
    uint tokens;
    uint n_blocks;
    uint topk_blocks;
    uint max_ids;
    int pos0;
    uint dense; // unused (the dense path stays on qsa_topk.comp)
} pc;

#define WG_X_MAX 65535u
#define NT 1024u
#define UNROLL 8u
#define RUN 8u // emission: a thread's contiguous run is loaded RUN at a time
#define NBINS 2048u
// Lane-interleaved histogram copies: a wave's same-bin atomics hit 4 words in
// different banks instead of one (tie-heavy rows serialize on a single bin).
#define NCOPY 4u

shared uint hist[NBINS * NCOPY];
shared uvec2 s_scan[NT];
shared uint s_prefix;
shared uint s_mask;
shared uint s_left;
shared uint s_done;
shared uint s_own_found;
shared uint s_want;

uint key_of(float s) {
    uint u = floatBitsToUint(s);
    return (u & 0x80000000u) != 0u ? ~u : (u | 0x80000000u);
}

// Inclusive Hillis-Steele scan of s_scan[0..NT) (both lanes).
void scan_inclusive(uint tid) {
    for (uint off = 1u; off < NT; off <<= 1u) {
        uvec2 v = tid >= off ? s_scan[tid - off] : uvec2(0u);
        barrier();
        s_scan[tid] += v;
        barrier();
    }
}

void main() {
    uint t = gl_WorkGroupID.y * WG_X_MAX + gl_WorkGroupID.x;
    if (t >= pc.tokens) {
        return;
    }
    uint tid = gl_LocalInvocationID.x;
    uint base = t * pc.n_blocks;
    int pos = pc.pos0 + int(t);
    uint own = uint(pos) / 4u;
    uint n_vis = pc.n_blocks; // liveness comes from the scores, as in the serial kernel

    if (tid == 0u) {
        s_prefix = 0u;
        s_mask = 0u;
        s_done = 0u;
        s_own_found = 0u;
        s_want = 0u;
        s_left = 0u;
    }
    barrier();

    // Find the want-th largest key: prefix/mask cover the decided high bits,
    // `left` = how many of the keys matching the prefix are still to take.
    for (uint pass = 0u; pass < 3u; ++pass) {
        if (s_done != 0u) {
            break;
        }
        uint shift = pass == 0u ? 21u : (pass == 1u ? 10u : 0u);
        uint nb = pass == 2u ? 1024u : 2048u;
        uint bm = nb - 1u;
        uint prefix = s_prefix;
        uint mask = s_mask;
        for (uint i = tid; i < NBINS * NCOPY; i += NT) {
            hist[i] = 0u;
        }
        uint copy = tid & (NCOPY - 1u);
        barrier();
        for (uint b0 = tid; b0 < n_vis; b0 += NT * UNROLL) {
            float v[UNROLL];
            for (uint u = 0u; u < UNROLL; ++u) {
                uint b = b0 + u * NT;
                v[u] = b < n_vis ? SC[base + b] : -1.0e30;
            }
            for (uint u = 0u; u < UNROLL; ++u) {
                uint k = key_of(v[u]);
                if (v[u] > -1.0e29 && (k & mask) == prefix) {
                    atomicAdd(hist[((k >> shift) & bm) * NCOPY + copy], 1u);
                }
            }
        }
        barrier();

        // Thread j owns the bins [nb - per*(j+1), nb - per*j): thread 0 the highest,
        // so an inclusive scan over threads counts the keys at or above each bin run.
        uint per = nb / NT;
        uint top = nb - per * tid;
        uint mine = 0u;
        for (uint i = 0u; i < per; ++i) {
            uint bin = top - 1u - i;
            uint h = 0u;
            for (uint c = 0u; c < NCOPY; ++c) {
                h += hist[bin * NCOPY + c];
            }
            hist[bin * NCOPY] = h; // copy 0 holds the bin total from here on
            mine += h;
        }
        s_scan[tid] = uvec2(mine, 0u);
        barrier();
        scan_inclusive(tid);
        uint incl = s_scan[tid].x;
        uint total = s_scan[NT - 1u].x;

        uint left = s_left;
        bool select = true;
        if (pass == 0u) {
            uint want = min(min(pc.topk_blocks, total), pc.max_ids);
            left = want;
            // Every live block fits (short context): prefix/mask 0 make all
            // live keys "equal", taken with budget = live, no further passes.
            if (want == total || want == 0u) {
                select = false;
                if (tid == 0u) {
                    s_want = want;
                    s_left = want;
                    s_done = 1u;
                }
            } else if (tid == 0u) {
                s_want = want;
            }
        }
        uint excl = incl - mine;
        if (select && excl < left && left <= incl) {
            uint cum = excl;
            for (uint i = 0u; i < per; ++i) {
                uint bin = top - 1u - i;
                uint h = hist[bin * NCOPY];
                if (cum + h >= left) {
                    uint rest = left - cum;
                    s_left = rest;
                    s_done = (h == rest || pass == 2u) ? 1u : 0u;
                    s_prefix = prefix | (bin << shift);
                    s_mask = mask | (bm << shift);
                    break;
                }
                cum += h;
            }
        }
        barrier();
    }

    uint want = s_want;
    uint prefix = s_prefix;
    uint mask = s_mask;
    uint budget = s_left; // keys equal to the prefix that are taken, lowest index first

    uint per = (n_vis + NT - 1u) / NT;
    uint lo = min(tid * per, n_vis);
    uint hi = min(lo + per, n_vis);
    uvec2 c = uvec2(0u);
    if (want > 0u) {
        for (uint b0 = lo; b0 < hi; b0 += RUN) {
            float v[RUN];
            for (uint u = 0u; u < RUN; ++u) {
                v[u] = b0 + u < hi ? SC[base + b0 + u] : -1.0e30;
            }
            for (uint u = 0u; u < RUN; ++u) {
                uint k = key_of(v[u]) & mask;
                bool live = v[u] > -1.0e29;
                c += uvec2(live && k > prefix ? 1u : 0u, live && k == prefix ? 1u : 0u);
            }
        }
    }
    s_scan[tid] = c;
    barrier();
    scan_inclusive(tid);
    uvec2 ex = s_scan[tid] - c;

    if (want > 0u) {
        uint eq_seen = ex.y;
        uint out_i = ex.x + min(ex.y, budget);
        for (uint b0 = lo; b0 < hi; b0 += RUN) {
          float v[RUN];
          for (uint u = 0u; u < RUN; ++u) {
              v[u] = b0 + u < hi ? SC[base + b0 + u] : -1.0e30;
          }
          for (uint u = 0u; u < RUN; ++u) {
            uint b = b0 + u;
            float s = v[u];
            if (!(s > -1.0e29)) {
                continue; // dead, or past the run (padded with the mask value)
            }
            uint k = key_of(s) & mask;
            bool take = k > prefix;
            if (k == prefix) {
                take = eq_seen < budget;
                eq_seen += 1u;
            }
            if (take) {
                IDS[t * pc.max_ids + out_i] = b;
                out_i += 1u;
                if (b == own) {
                    s_own_found = 1u;
                }
            }
          }
        }
    }
    barrier();

    if (tid == 0u) {
        uint count = want;
        if (s_own_found == 0u && count < pc.max_ids) {
            IDS[t * pc.max_ids + count] = own;
            count += 1u;
        }
        CNT[t] = count;
    }
}
