#version 450
// Device-side row map for the batched expert GEMV: the router's top-k ids stay
// in VRAM and this kernel turns them into the `GemvBatch` indirection, so the
// host never sees them for a GPU-resident expert block.
//
// map[0, rows)      = row's block base, in u16 words into W
// map[rows, 2*rows) = row's activation base, in vec4 units into X
// (the layout `GemvBatch::map_for_blobs` builds on the host)
//
// The entry is **per row**, not per expert: row `r` of expert `id` lives at
// `base_words + id*blob_words + r*bpr*block_words`, exactly as
// `GemvBatch::map_for_blobs` lays it out. Writing the expert base for every row
// (the first version of this kernel) makes all rows of an expert read its first
// row — finite, plausible, wrong.
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer Ids { uint IDS[]; };
layout(std430, binding = 1) writeonly buffer Map { uint MAP[]; };

layout(push_constant) uniform Params {
    uint experts;
    uint rows_per_expert;
    uint blob_words;
    uint base_words;
    uint per_expert_pc4; // 0 = one shared activation, else padded_cols / 4
    uint rows_total;
    uint bpr;            // blocks per row
    uint block_words;     // u16 words per quant block
} pc;

#define WG_X_MAX 65535u

void main() {
    uint wg = gl_WorkGroupID.y * WG_X_MAX + gl_WorkGroupID.x;
    uint row = wg * 64u + gl_LocalInvocationID.x;
    if (row >= pc.rows_total) {
        return;
    }
    uint j = row / pc.rows_per_expert;
    if (j >= pc.experts) {
        return;
    }
    uint r = row - j * pc.rows_per_expert;
    // A tail-skipped slot (router id 0xFFFFFFFF) maps to the dead-row marker the
    // expert GEMV recognises; its activation base stays valid.
    uint id = IDS[j];
    MAP[row] = id == 0xFFFFFFFFu
        ? 0xFFFFFFFFu
        : pc.base_words + id * pc.blob_words + r * pc.bpr * pc.block_words;
    MAP[pc.rows_total + row] = pc.per_expert_pc4 == 0u ? 0u : j * pc.per_expert_pc4;
}
