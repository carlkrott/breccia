; mixed_dot_probe.spvasm - the build-time proof that OpFDot2MixAcc32VALVE
; (SPV_VALVE_mixed_float_dot_product) assembles and runs on this toolchain.
; Generated by a small script and committed as text, like intdot_probe.spvasm:
; `build.rs::assemble` runs spirv-as + spirv-val on it exactly like the compiled
; shaders, so the engine can include_bytes! it. Two f16 MACs into an f32
; accumulator, one instruction, in a runtime-bounded loop so nothing folds.
OpCapability Shader
OpCapability DotProductFloat16AccFloat32VALVE
OpCapability Float16
OpExtension "SPV_VALVE_mixed_float_dot_product"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %main "main" %pcv %data %gid
OpExecutionMode %main LocalSize 64 1 1
OpDecorate %pc Block
OpMemberDecorate %pc 0 Offset 0
OpDecorate %data DescriptorSet 0
OpDecorate %data Binding 0
OpDecorate %arr ArrayStride 4
OpDecorate %S Block
OpMemberDecorate %S 0 Offset 0
OpDecorate %gid BuiltIn GlobalInvocationId
%void = OpTypeVoid
%fn = OpTypeFunction %void
%f32 = OpTypeFloat 32
%half = OpTypeFloat 16
%v2half = OpTypeVector %half 2
%u32 = OpTypeInt 32 0
%bool = OpTypeBool
%v3u32 = OpTypeVector %u32 3
%u32_0 = OpConstant %u32 0
%u32_1 = OpConstant %u32 1
%f0 = OpConstant %f32 0.0
%f1 = OpConstant %f32 1.0009765625
%h3 = OpConstant %half 3.0
%h4 = OpConstant %half 4.0
%vb = OpConstantComposite %v2half %h3 %h4
%arr = OpTypeRuntimeArray %f32
%S = OpTypeStruct %arr
%pc = OpTypeStruct %u32
%ptr_pc = OpTypePointer PushConstant %pc
%ptr_pc_u32 = OpTypePointer PushConstant %u32
%ptr = OpTypePointer StorageBuffer %S
%ptr_f32 = OpTypePointer StorageBuffer %f32
%ptr_v3u32 = OpTypePointer Input %v3u32
%pcv = OpVariable %ptr_pc PushConstant
%data = OpVariable %ptr StorageBuffer
%gid = OpVariable %ptr_v3u32 Input
%main = OpFunction %void None %fn
%entry = OpLabel
%nptr = OpAccessChain %ptr_pc_u32 %pcv %u32_0
%n = OpLoad %u32 %nptr
%g = OpLoad %v3u32 %gid
%gx = OpCompositeExtract %u32 %g 0
%gx1 = OpIAdd %u32 %gx %u32_1
%fx = OpConvertUToF %f32 %gx1
%mul = OpFMul %f32 %fx %f1
%hx = OpFConvert %half %fx
%va = OpCompositeConstruct %v2half %hx %hx
%seed0 = OpFAdd %f32 %fx %f0
%seed1 = OpFAdd %f32 %fx %f0
%seed2 = OpFAdd %f32 %fx %f0
%seed3 = OpFAdd %f32 %fx %f0
%seed4 = OpFAdd %f32 %fx %f0
%seed5 = OpFAdd %f32 %fx %f0
%seed6 = OpFAdd %f32 %fx %f0
%seed7 = OpFAdd %f32 %fx %f0
OpBranch %header
%header = OpLabel
%i = OpPhi %u32 %u32_0 %entry %inext %continue
 %acc0 = OpPhi %f32 %seed0 %entry %b0 %continue
 %acc1 = OpPhi %f32 %seed1 %entry %b1 %continue
 %acc2 = OpPhi %f32 %seed2 %entry %b2 %continue
 %acc3 = OpPhi %f32 %seed3 %entry %b3 %continue
 %acc4 = OpPhi %f32 %seed4 %entry %b4 %continue
 %acc5 = OpPhi %f32 %seed5 %entry %b5 %continue
 %acc6 = OpPhi %f32 %seed6 %entry %b6 %continue
 %acc7 = OpPhi %f32 %seed7 %entry %b7 %continue
%done = OpUGreaterThanEqual %bool %i %n
OpLoopMerge %merge %continue None
OpBranchConditional %done %merge %body
%body = OpLabel
%b0 = OpFDot2MixAcc32VALVE %f32 %va %vb %acc0
%b1 = OpFDot2MixAcc32VALVE %f32 %va %vb %acc1
%b2 = OpFDot2MixAcc32VALVE %f32 %va %vb %acc2
%b3 = OpFDot2MixAcc32VALVE %f32 %va %vb %acc3
%b4 = OpFDot2MixAcc32VALVE %f32 %va %vb %acc4
%b5 = OpFDot2MixAcc32VALVE %f32 %va %vb %acc5
%b6 = OpFDot2MixAcc32VALVE %f32 %va %vb %acc6
%b7 = OpFDot2MixAcc32VALVE %f32 %va %vb %acc7
OpBranch %continue
%continue = OpLabel
%inext = OpIAdd %u32 %i %u32_1
OpBranch %header
%merge = OpLabel
%m1 = OpFAdd %f32 %acc0 %acc1
%m2 = OpFAdd %f32 %m1 %acc2
%m3 = OpFAdd %f32 %m2 %acc3
%m4 = OpFAdd %f32 %m3 %acc4
%m5 = OpFAdd %f32 %m4 %acc5
%m6 = OpFAdd %f32 %m5 %acc6
%m7 = OpFAdd %f32 %m6 %acc7
%idx = OpAccessChain %ptr_f32 %data %u32_0 %gx
OpStore %idx %m7
OpReturn
OpFunctionEnd
