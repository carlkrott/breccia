// Block decode for the GGML quant types present in the target model.
//
// Adapted from llama.cpp (MIT):
//   * Reference CPU semantics: ggml/src/ggml-quants.c  (dequantize_row_iq2_xxs,
//     dequantize_row_iq2_xs, dequantize_row_iq3_xxs, dequantize_row_iq3_s,
//     dequantize_row_iq4_nl, dequantize_row_q5_K, dequantize_row_q2_0),
//     commit 6050b46 (the qwen4exp fork: it is the one that defines Q2_0).
//   * GPU structuring (16-bit-word SSBO views, per-lane unit split, two-grid
//     nibble unpack): ggml-vulkan vulkan-shaders/types.glsl,
//     vulkan-shaders/mul_mat_vec_iq3_s.comp, mul_mat_vec_iq2_xxs.comp,
//     mul_mat_vec_iq4_nl path, same commit.
// Grid / sign / value tables: uploaded via `QuantTables` (binding 3) from
// `tables::GPU_TABLE_WORDS`, generated from ggml-common.h by tools/gen_tables.py.
//
// Every supported type decodes into units of 8 CONSECUTIVE elements, which is
// what lets one warp cover a whole 256-element super-block with 32 lanes
// (and 32-element IQ4_NL blocks with 4 lanes per block). Field offsets are
// expressed in 16-bit words, because every GGML block is an even number of
// bytes but not necessarily a multiple of four (66/74/98/110 B), so 32-bit
// loads at block starts are not always aligned.
//
// W[] is the raw weight bytes; `off` is the u16-word offset of the block start.

#ifndef BRECCIA_BLOCKS_GLSL
#define BRECCIA_BLOCKS_GLSL

#ifndef BRECCIA_OWN_BINDINGS
layout(std430, binding = 0) readonly buffer WeightBytes { uint16_t W[]; };
layout(std430, binding = 1) readonly buffer XVec { vec4 X[]; };
layout(std430, binding = 2) writeonly buffer OutVec { float O[]; };

// Quant tables. These live in a small read-only storage buffer (7 KB) rather
// than in GLSL `const` arrays: a dynamically indexed const array is lowered to
// private memory on RADV and spills, which cost 2 orders of magnitude of
// throughput when measured (docs/phase-3/01-dequant-gemv.md §4). The buffer
// stays resident in L1/L2 for the whole kernel, and the host uploads it once
// per pipeline (`tables::GPU_TABLE_WORDS`, generated by tools/gen_tables.py).
// The bases below MUST match `tables::TBL_*` (checked by a unit test).
layout(std430, binding = 3) readonly buffer QuantTables { uint T[]; };
#endif // BRECCIA_OWN_BINDINGS

#define TBL_SIGNS 2304u
#define TBL_IQ2XXS_LO 0u
#define TBL_IQ2XXS_HI 256u
#define TBL_IQ2XS_LO 512u
#define TBL_IQ2XS_HI 1024u
#define TBL_IQ3XXS_GRID 1536u
#define TBL_IQ3S_GRID 1792u
#define TBL_IQ4NL_VALUES 2432u
// Appended for the second kernel pass (IQ2_S's 1024-entry u64 grid): the
// earlier offsets above are untouched.
#define TBL_IQ2S_LO 2448u
#define TBL_IQ2S_HI 3472u

// Every table accessor masks its index to the table's own length. The indices
// themselves are *packet bits* (grid/sign codes), never float data — but the
// mask makes the address provably in-bounds even if a caller (or a future
// decode unit) hands over an unmasked value: a bad index must never be able to
// turn into an out-of-bounds SSBO read, which faults the GPU rather than
// returning garbage (docs/phase-3/02-expert-batching-quants.md §4).
// `lib.rs::table_accessors_are_bounded` checks these masks against the bases.
uint sign_code(uint i) { return T[TBL_SIGNS + (i & 127u)]; }        // 128
uint grid_iq2xxs_lo(uint i) { return T[TBL_IQ2XXS_LO + (i & 255u)]; } // 256
uint grid_iq2xxs_hi(uint i) { return T[TBL_IQ2XXS_HI + (i & 255u)]; } // 256
uint grid_iq2xs_lo(uint i) { return T[TBL_IQ2XS_LO + (i & 511u)]; }   // 512
uint grid_iq2xs_hi(uint i) { return T[TBL_IQ2XS_HI + (i & 511u)]; }   // 512
uint grid_iq3xxs(uint i) { return T[TBL_IQ3XXS_GRID + (i & 255u)]; }  // 256
uint grid_iq3s(uint i) { return T[TBL_IQ3S_GRID + (i & 511u)]; }      // 512
uint grid_iq2s_lo(uint i) { return T[TBL_IQ2S_LO + (i & 1023u)]; }    // 1024
uint grid_iq2s_hi(uint i) { return T[TBL_IQ2S_HI + (i & 1023u)]; }    // 1024
/// IQ4_NL non-linear values are int8 -127..113, stored as int32 words.
float iq4nl_value(uint q) { return float(int(T[TBL_IQ4NL_VALUES + (q & 15u)])); }

#ifndef BRECCIA_OWN_BINDINGS
layout(push_constant) uniform Params {
    uint rows;   // output rows
    uint cols;   // row length in elements
    uint bpr;    // blocks per row = ceil(cols / QK)
    uint splits; // split-K factor (1 = single pass, result written directly)
    // 5th word, multi-user GEMM only (§8v): the expert's blob offset inside the
    // resident arena, in 16-bit words. The GEMV dispatches push 16 bytes and never
    // read it; the multi-user GEMM pushes 20.
    uint base;
#ifdef BRECCIA_HC_GATED_EPILOGUE
    // The fused HC `up` + gated-mean variant (§8az) needs the column geometry:
    // `n_embd` elements per hyper-connection stream, `hc` streams, and the number
    // of inject partial chunks this build writes (one per workgroup).
    uint n_embd;
    uint hc;
    uint chunks;
#endif
#ifdef BRECCIA_GEMV_EPILOGUE_SILU_DIV
    // 6th word, the `_hcact` GEMV builds only: the `silu_div` divisor `s` of the
    // activation applied to the accumulated row value before it is stored (the
    // HC mixer's bottleneck activation, `ops_act.comp` mode `SiluDiv`). Those
    // builds push 24 bytes. It is a *wired* addition — same bindings, same
    // resources, same accumulation order — so the value the kernel stores is
    // bit-identical to what a separate `Act` dispatch reads back and rewrites.
    float ep;
#endif
} pc;
#endif

// ---- word/byte accessors ---------------------------------------------------

uint u16_at(uint w) { return uint(W[w]); }

// Two consecutive 16-bit words as one little-endian 32-bit value.
uint u32_at(uint w) { return uint(W[w]) | (uint(W[w + 1u]) << 16); }

// Bytes 8i..8i+7 of a value extended to 32 bits (j in 0..3).
uint byte4(uint v, uint j) { return (v >> (8u * j)) & 0xffu; }

// Byte `i` (0..1) of the 16-bit word at `w`.
uint byte2(uint w, uint i) { return (uint(W[w]) >> (8u * i)) & 0xffu; }

// fp16 -> fp32. Exact (hardware conversion), keeps subnormals/inf/nan.
float f16_at(uint w) { return unpackHalf2x16(uint(W[w])).x; }

/// Byte `b` of the block whose first word is `off` (b = 0 is the low byte).
uint block_byte(uint off, uint b) { return byte2(off + (b >> 1u), b & 1u); }

/// Signed byte `b` of the block (int8 fields: Q6_K scales).
int block_i8(uint off, uint b) {
    int v = int(block_byte(off, b));
    return (v & 0x80) != 0 ? v - 256 : v;
}


// K-quant block scale byte (`scales[i]` of Q4_K/Q5_K: 12 bytes at block byte 4).
uint scale_byte_k(uint off, uint i) { return byte2(off + 2u + (i >> 1u), i & 1u); }

// ---- IQ2_XXS  (256 elements / 66 B) ---------------------------------------

// d: word 0 | qs: words 1..32  (per 32-element group: 4 grid bytes + 4 sign/
// scale bytes; the top nibble of the group's 8th byte is the sub-scale).
void dequant_iq2_xxs_unit(uint off, uint u, out float v[8]) {
    uint ib32 = u >> 2u;
    uint l = u & 3u;
    uint q0 = u32_at(off + 1u + 4u * ib32); // aux8[0..3] = grid indices
    uint q1 = u32_at(off + 3u + 4u * ib32); // aux8[4..7]: signs + scale nibble
    float db = f16_at(off) * (0.5 + float(q1 >> 28u)) * 0.25;
    uint idx = byte4(q0, l);
    uint sgn = sign_code(q1 >> (7u * l));
    uint lo = grid_iq2xxs_lo(idx);
    uint hi = grid_iq2xxs_hi(idx);
    for (uint j = 0u; j < 8u; ++j) {
        uint g = j < 4u ? byte4(lo, j) : byte4(hi, j - 4u);
        float t = db * float(g);
        v[j] = (sgn & (1u << j)) != 0u ? -t : t;
    }
}

// ---- IQ2_XS  (256 elements / 74 B) ----------------------------------------

// d: word 0 | qs: words 1..32 (u16 each: 9-bit grid index + 7-bit sign code)
// scales: bytes 66..73 (2 u8 nibbles per 32-element group) = words 33..36.
void dequant_iq2_xs_unit(uint off, uint u, out float v[8]) {
    uint ib32 = u >> 2u;
    uint l = u & 3u;
    uint qs = u16_at(off + 1u + 4u * ib32 + l);
    uint sc = byte2(off + 33u + (ib32 >> 1u), ib32 & 1u);
    uint nib = l < 2u ? (sc & 0x0fu) : (sc >> 4u);
    float db = f16_at(off) * (0.5 + float(nib)) * 0.25;
    uint idx = qs & 511u;
    uint sgn = sign_code(qs >> 9u);
    uint lo = grid_iq2xs_lo(idx);
    uint hi = grid_iq2xs_hi(idx);
    for (uint j = 0u; j < 8u; ++j) {
        uint g = j < 4u ? byte4(lo, j) : byte4(hi, j - 4u);
        float t = db * float(g);
        v[j] = (sgn & (1u << j)) != 0u ? -t : t;
    }
}

// ---- IQ2_S  (256 elements / 82 B) -----------------------------------------

// d: word 0 | qs: bytes 2..33 (one 8-bit grid index per 8-element unit) |
// signs: bytes 34..65 (one sign byte per unit) | qh: bytes 66..73 (2 extra
// index bits per 32-element group) | scales: bytes 74..81 (2 nibbles/group).
void dequant_iq2_s_unit(uint off, uint u, out float v[8]) {
    uint ib32 = u >> 2u;
    uint l = u & 3u;
    uint q = byte2(off + 1u + (u >> 1u), u & 1u);         // qs[u]        byte 2+u
    uint h = byte2(off + 33u + (ib32 >> 1u), ib32 & 1u);  // qh[ib32]     byte 66+
    uint sc = byte2(off + 37u + (ib32 >> 1u), ib32 & 1u); // scales[ib32] byte 74+
    uint nib = l < 2u ? (sc & 0x0fu) : (sc >> 4u);
    float db = f16_at(off) * (0.5 + float(nib)) * 0.25;
    // 8 packet bits + 2 extra bits per group = a 10-bit grid index (0..1023).
    uint idx = (q | ((h << (8u - 2u * l)) & 0x300u)) & 1023u;
    uint sgn = byte2(off + 17u + (u >> 1u), u & 1u);      // signs[u]     byte 34+u
    uint lo = grid_iq2s_lo(idx);
    uint hi = grid_iq2s_hi(idx);
    for (uint j = 0u; j < 8u; ++j) {
        uint g = j < 4u ? byte4(lo, j) : byte4(hi, j - 4u);
        float t = db * float(g);
        v[j] = (sgn & (1u << j)) != 0u ? -t : t;
    }
}

// ---- IQ3_XXS  (256 elements / 98 B) ---------------------------------------

// d: word 0 | qs: bytes 2..65 (8 bytes per 32-element group = 2 grids of 4)
// scales+signs: bytes 66..97 (4 bytes per group: 4 sign bytes + scale nibble).
void dequant_iq3_xxs_unit(uint off, uint u, out float v[8]) {
    uint ib32 = u >> 2u;
    uint l = u & 3u;
    uint qa = u32_at(off + 1u + 4u * ib32 + 2u * (l >> 1u));
    uint q1 = u32_at(off + 33u + 2u * ib32);
    float db = f16_at(off) * (0.5 + float(q1 >> 28u)) * 0.5;
    uint g1 = byte4(qa, 2u * (l & 1u));
    uint g2 = byte4(qa, 2u * (l & 1u) + 1u);
    uint sgn = sign_code(q1 >> (7u * l));
    uint lo1 = grid_iq3xxs(g1);
    uint lo2 = grid_iq3xxs(g2);
    for (uint j = 0u; j < 4u; ++j) {
        float a = db * float(byte4(lo1, j));
        float b = db * float(byte4(lo2, j));
        v[j] = (sgn & (1u << j)) != 0u ? -a : a;
        v[j + 4u] = (sgn & (1u << (j + 4u))) != 0u ? -b : b;
    }
}

// ---- IQ3_S  (256 elements / 110 B) ----------------------------------------

// d: word 0 | qs: bytes 2..65 | qh: bytes 66..73 | signs: bytes 74..105
// scales: bytes 106..109 (4-bit nibbles, 2 per 32-element group).
void dequant_iq3_s_unit(uint off, uint u, out float v[8]) {
    uint ib32 = u >> 2u;
    uint l = u & 3u;
    uint qhb = byte2(off + 33u + (ib32 >> 1u), ib32 & 1u);
    uint sc = byte2(off + 53u + (ib32 >> 2u), (ib32 >> 1u) & 1u);
    uint nib = (ib32 & 1u) == 0u ? (sc & 0x0fu) : (sc >> 4u);
    float db = f16_at(off) * (1.0 + 2.0 * float(nib));
    uint qa = u32_at(off + 1u + 4u * ib32 + 2u * (l >> 1u));
    uint g1 = byte4(qa, 2u * (l & 1u)) | ((qhb << (8u - 2u * l)) & 256u);
    uint g2 = byte4(qa, 2u * (l & 1u) + 1u) | ((qhb << (7u - 2u * l)) & 256u);
    uint sb = 4u * ib32 + l;
    uint sgn = byte2(off + 37u + (sb >> 1u), sb & 1u);
    uint lo1 = grid_iq3s(g1);
    uint lo2 = grid_iq3s(g2);
    for (uint j = 0u; j < 4u; ++j) {
        float a = db * float(byte4(lo1, j));
        float b = db * float(byte4(lo2, j));
        v[j] = (sgn & (1u << j)) != 0u ? -a : a;
        v[j + 4u] = (sgn & (1u << (j + 4u))) != 0u ? -b : b;
    }
}

// ---- IQ4_NL  (32 elements / 18 B) -----------------------------------------

// d: word 0 | qs: bytes 2..17 = 16 nibble-pairs; elements 0..15 are the low
// nibbles, 16..31 the high nibbles (ggml layout, not interleaved).
void dequant_iq4_nl_unit(uint off, uint u, out float v[8]) {
    uint base = off + 1u + 4u * (u & 1u); // qs[(u&1)*8 .. +8] -> 4 words
    uint hi = u >> 1u;
    float d = f16_at(off);
    for (uint j = 0u; j < 8u; ++j) {
        uint b = byte2(base + (j >> 1u), j & 1u);
        uint q = hi == 0u ? (b & 0x0fu) : (b >> 4u);
        v[j] = d * iq4nl_value(q);
    }
}

// ---- IQ4_XS  (256 elements / 136 B) ---------------------------------------

// d: word 0 | scales_h: u16 at byte 2 | scales_l: bytes 4..7 | qs: bytes
// 8..135 (16 bytes per 32-element group). Same nibble order as IQ4_NL (low
// nibbles are the group's first 16 elements, high nibbles the last 16), plus a
// per-32-element scale: dl = d * (scale6 - 32).
void dequant_iq4_xs_unit(uint off, uint u, out float v[8]) {
    uint ib = u >> 2u;      // 32-element group 0..7
    uint h = u & 3u;        // 8-element unit inside the group
    uint si = ib >> 1u;     // scales_l index 0..3 (one nibble pair per 2 groups)
    uint sh = u16_at(off + 1u);
    uint sl = byte2(off + 2u + (si >> 1u), si & 1u);
    uint ls = ((sl >> (4u * (ib & 1u))) & 0x0fu) | (((sh >> (2u * ib)) & 3u) << 4u);
    float dl = f16_at(off) * float(int(ls) - 32);
    uint base = off + 4u + 8u * ib + 4u * (h & 1u); // qs[ib*16 + h*8 .. +8] -> 4 words
    uint hi = h >> 1u;
#ifdef BRECCIA_WIDE_DEQUANT
    // Coalesced form of the same unit (§8ax): the unit's 8 qs bytes are 4 words
    // starting at `base` (8-byte aligned), so two 32-bit loads replace eight
    // two-byte ones whose 8-byte stride touched each sector 8 times. Values are
    // identical; `byte2(base + (j>>1), j&1)` is `byte4` of the two words.
    uint w0 = u32_at(base);
    uint w1 = u32_at(base + 2u);
    for (uint j = 0u; j < 8u; ++j) {
        uint b = byte4(j < 4u ? w0 : w1, j & 3u);
        uint q = hi == 0u ? (b & 0x0fu) : (b >> 4u);
        v[j] = dl * iq4nl_value(q);
    }
#else
    for (uint j = 0u; j < 8u; ++j) {
        uint b = byte2(base + (j >> 1u), j & 1u);
        uint q = hi == 0u ? (b & 0x0fu) : (b >> 4u);
        v[j] = dl * iq4nl_value(q);
    }
#endif
}

// ---- Q4_K  (256 elements / 144 B) -----------------------------------------

// dm: words 0..1 | scales: bytes 4..15 (get_scale_min_k4) | qs: bytes 16..143.
// element = d*sc*q - dmin*m, q = low nibble for the sub-block's first 32
// elements, high nibble for the second.
void dequant_q4_k_unit(uint off, uint u, out float v[8]) {
    uint g = u >> 3u;      // 64-element group 0..3
    uint s = u & 7u;       // 8-element unit inside the group
    uint sub = s >> 2u;    // 32-element sub-block 0..1
    uint j = 2u * g + sub; // sub-block index 0..7 (get_scale_min_k4)
    uint sc;
    uint mn;
    if (j < 4u) {
        sc = scale_byte_k(off, j) & 63u;
        mn = scale_byte_k(off, j + 4u) & 63u;
    } else {
        sc = (scale_byte_k(off, j + 4u) & 0x0fu) | ((scale_byte_k(off, j - 4u) >> 6u) << 4u);
        mn = (scale_byte_k(off, j + 4u) >> 4u) | ((scale_byte_k(off, j) >> 6u) << 4u);
    }
    float d = f16_at(off) * float(sc);
    float dm = f16_at(off + 1u) * float(mn);
    uint l0 = (s & 3u) * 8u;          // element offset inside the 32-element sub-block
    uint qbase = off + 8u + 16u * g;  // qs byte 16 + 32*g, in words
    for (uint jj = 0u; jj < 8u; ++jj) {
        uint b = byte2(qbase + ((l0 + jj) >> 1u), (l0 + jj) & 1u);
        uint q = sub == 0u ? (b & 0x0fu) : (b >> 4u);
        v[jj] = d * float(q) - dm;
    }
}

// ---- Q5_K  (256 elements / 176 B) -----------------------------------------

// dm: words 0..1 | scales: bytes 4..15 | qh: bytes 16..47 | qs: bytes 48..175
// weight = d*sc*q - dmin*m, q = 4-bit nibble + 5th bit from qh (bit 2g/2g+1).

void dequant_q5_k_unit(uint off, uint u, out float v[8]) {
    uint g = u >> 3u;     // 64-element group 0..3
    uint s = u & 7u;      // 8-element unit inside the group
    uint j = 2u * g + (s >= 4u ? 1u : 0u); // 32-element sub-block 0..7
    uint sc;
    uint mn;
    if (j < 4u) {
        sc = scale_byte_k(off, j) & 63u;
        mn = scale_byte_k(off, j + 4u) & 63u;
    } else {
        sc = (scale_byte_k(off, j + 4u) & 0x0fu) | ((scale_byte_k(off, j - 4u) >> 6u) << 4u);
        mn = (scale_byte_k(off, j + 4u) >> 4u) | ((scale_byte_k(off, j) >> 6u) << 4u);
    }
    float d = f16_at(off) * float(sc);
    float dm = f16_at(off + 1u) * float(mn);
    uint l0 = (s & 3u) * 8u;             // element offset inside the sub-block
    uint ql0 = g * 32u + l0;             // qs/ql byte, qh byte share the index
    uint mask = (s < 4u ? 1u : 2u) << (2u * g);
#ifdef BRECCIA_WIDE_DEQUANT
    // **Coalesced unit load** (`docs/phase-4/01` §8ax). The per-element form below
    // issues 16 two-byte loads per unit whose 8-byte lane stride makes every
    // 32-byte sector be touched 8 times: measured **140 M elements/ms** on the
    // MI50, against **405 M** for the same shape in BF16 (= 98 % of DRAM), i.e.
    // the Q5_K head was sector/instruction bound, not bandwidth bound. Here the
    // unit's whole 8 ql bytes (block bytes 48+ql0, 8-byte aligned) and 8 qh bytes
    // (16+l0) are read as two 32-bit words each and unpacked from registers: one
    // load per half-unit, four sectors per instruction, same arithmetic and the
    // same values (the conformance suite is bit-identical).
    uint qw = off + 24u + (ql0 >> 1u); // u16 words of the unit's 8 ql bytes
    uint hw = off + 8u + (l0 >> 1u);   // u16 words of the unit's 8 qh bytes
    uint qa = u32_at(qw);
    uint qb = u32_at(qw + 2u);
    uint ha = u32_at(hw);
    uint hb = u32_at(hw + 2u);
    uint shift = s < 4u ? 0u : 4u;
    for (uint jj = 0u; jj < 8u; ++jj) {
        uint nib = (byte4(jj < 4u ? qa : qb, jj & 3u) >> shift) & 0x0fu;
        uint hi = byte4(jj < 4u ? ha : hb, jj & 3u);
        v[jj] = d * float(nib + ((hi & mask) != 0u ? 16u : 0u)) - dm;
    }
#else
    for (uint jj = 0u; jj < 8u; ++jj) {
        uint idx = ql0 + jj;
        uint qb = byte2(off + 24u + (idx >> 1u), idx & 1u);
        uint nib = s < 4u ? (qb & 0x0fu) : (qb >> 4u);
        uint hb = byte2(off + 8u + ((l0 + jj) >> 1u), (l0 + jj) & 1u);
        uint q = nib + ((hb & mask) != 0u ? 16u : 0u);
        v[jj] = d * float(q) - dm;
    }
#endif
}

// ---- Q6_K  (256 elements / 210 B) -----------------------------------------

// ql: bytes 0..127 (low 4 bits) | qh: bytes 128..191 (high 2 bits) | scales:
// bytes 192..207 (16 int8) | d: word 104. Per 128-element half and 32-element
// quarter q (0..3): value = d * sc[grp*8 + l/16 + 2q] * (nib | hi2<<4 - 32),
// where the low nibble comes from ql[l] (q even) or ql[l+32] (q odd).
void dequant_q6_k_unit(uint off, uint u, out float v[8]) {
    uint grp = u >> 4u;         // 128-element half 0..1
    uint q = (u >> 2u) & 3u;    // 32-element quarter 0..3
    uint l0 = (u & 3u) * 8u;    // element offset inside the quarter
    uint ql = grp * 64u + l0;   // byte of ql for this unit
    uint qh = 128u + grp * 32u + l0;
    uint sc0 = 192u + grp * 8u + 2u * q;
    float d = f16_at(off + 104u);
    uint shift = 2u * q;
    for (uint jj = 0u; jj < 8u; ++jj) {
        uint l = l0 + jj;
        uint hb = block_byte(off, qh + jj);
        uint nb = block_byte(off, ql + jj + ((q & 1u) != 0u ? 32u : 0u));
        uint nib = q >= 2u ? (nb >> 4u) : (nb & 0x0fu);
        uint hi2 = (hb >> shift) & 3u;
        int qv = int(nib | (hi2 << 4u)) - 32;
        int sc = block_i8(off, sc0 + (l >> 4u));
        v[jj] = d * float(sc) * float(qv);
    }
}

// ---- Q2_0  (fork-only: 64 elements / 18 B) --------------------------------

// d: word 0 | qs: words 1..8 = 16 bytes of 2-bit codes, 4 per byte.
// Codes 0,1,2,3 map to -1,0,+1,+2 (ggml-quants.c dequantize_row_q2_0).
void dequant_q2_0_unit(uint off, uint u, out float v[8]) {
    float d = f16_at(off);
    uint w = u16_at(off + 1u + u); // 4 codes per byte -> 8 codes per word
    for (uint j = 0u; j < 8u; ++j) {
        uint q = (w >> (2u * j)) & 3u;
        v[j] = (float(q) - 1.0) * d;
    }
}

// ---- F16 / BF16 / F32  (viewed as 8-element "blocks") ---------------------

// The tensor types are per-element in GGUF; the kernels view them as virtual
// 8-element blocks so that every type shares one unit-of-8 decode contract.
void dequant_f16_unit(uint off, uint u, out float v[8]) {
    for (uint j = 0u; j < 8u; ++j) {
        v[j] = f16_at(off + 8u * u + j);
    }
}

void dequant_bf16_unit(uint off, uint u, out float v[8]) {
    for (uint j = 0u; j < 8u; ++j) {
        v[j] = uintBitsToFloat(u16_at(off + 8u * u + j) << 16);
    }
}

void dequant_f32_unit(uint off, uint u, out float v[8]) {
    for (uint j = 0u; j < 8u; ++j) {
        v[j] = uintBitsToFloat(u32_at(off + 16u * u + 2u * j));
    }
}

#endif // BRECCIA_BLOCKS_GLSL
