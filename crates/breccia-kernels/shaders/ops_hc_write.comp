#version 450
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_control_flow_attributes : enable
//
// HC_WRITE: the per-stream gated residual combine.
//
//   w[c]     = 2 * sigmoid(inject[c] / hc)        centres the gate on 1
//   R_out[c] = R[c] + block_out * w[c]            the SAME block_out to every stream
//
// (`docs/specs/qwen4exp-architecture.md` §4.1, `LC/src/models/qwen4exp.cpp:369-397`,
// `ST/include/strata/kernels/gr.hpp:121-124`.)
//
// Both halves of that contract are load-bearing and both are visible here:
// the gate is `2*sigmoid(...)` (so an `inject` of 0 gives exactly 1, i.e. a plain
// residual add) and it is divided by `hc` **before** the sigmoid, matching the
// `silu((xn @ w_down.T)/hc)` normalisation on the read side.
//
// Layout:
//   r, out :: [n_embd, hc, T]  -> index = (c + hc*t) * n_embd + d
//   block  :: [n_embd, T]      -> index =  t * n_embd + d
//   inject :: [T, hc, chunks]  -> index = (t*hc + c)*chunks + k   (`chunks` per-token
//                                   partial sums from ops_hc_gated_mean.comp)
//             or [hc, T]       -> index =  t*hc + c              (`chunks == 0`, plain)
//
// One workgroup per (token, 256-element chunk) so the `hc` gate values are
// computed once per token in shared memory instead of once per element.
//
// `r` and `out` may be the same buffer (in-place residual update): every element
// is read and written by exactly one invocation.
//
// The `chunks > 0` form consumes the partial dot products that
// `ops_hc_gated_mean.comp` produced while it was already walking `xn` — that is
// the fold described in `docs/phase-3/06-attention-gdn.md` (it removes one
// latency-bound 4x10240 GEMV from every HC_READ). Each of the token's `chunks`
// workgroups re-sums the same handful of floats, which is cheaper than a
// dispatch and keeps the sum deterministic and order-fixed.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer RVec { float R[]; };
layout(std430, binding = 1) readonly buffer BlockVec { float B[]; };
layout(std430, binding = 2) readonly buffer InjectVec { float INJ[]; };
layout(std430, binding = 3) writeonly buffer OVec { float O[]; };

layout(push_constant) uniform Params {
    uint n_embd;
    uint hc;      // streams (<= 32: the gate cache below is per workgroup)
    uint tokens;
    uint chunks;  // per-token partials of `inject` (0 = INJ already holds the sums)
} pc;

#include "ops_math.glsl"

shared float s_w[32];

void main() {
    uint t = gl_WorkGroupID.y;
    uint tid = gl_LocalInvocationID.x;
    if (t >= pc.tokens) {
        return;
    }
    // `chunks` is either the 256-element fold (`n_embd/256`, the incumbent shape) or,
    // when the fused `up`+gated-mean variant wrote them (§8az), one partial per
    // workgroup of that kernel (`n_embd/2`). The small case keeps the original
    // serial order bit for bit; the large one is summed by a **fixed 32-lane
    // strided tree**, which is deterministic (no atomics, no scheduling dependence)
    // but a different grouping — the reason the fused path's `inject` differs from
    // the incumbent by rounding only.
    if (pc.chunks <= 32u) {
        if (tid < pc.hc && tid < 32u) {
            float inj;
            if (pc.chunks == 0u) {
                inj = INJ[t * pc.hc + tid];
            } else {
                inj = 0.0;
                for (uint k = 0u; k < pc.chunks; ++k) {
                    inj += INJ[(t * pc.hc + tid) * pc.chunks + k];
                }
            }
            s_w[tid] = 2.0 * breccia_sigmoid(inj / float(pc.hc));
        }
    } else {
        uint lane = tid % 32u;
        uint c = tid / 32u;
        if (c < pc.hc) {
            // Four independent accumulators: a single dependent `+=` chain over
            // ~40 global loads is latency-bound (measured 15.7 us per call against
            // 5.5 us for the 10-chunk serial form), four chains hide it.
            float a0 = 0.0;
            float a1 = 0.0;
            float a2 = 0.0;
            float a3 = 0.0;
            const uint base = (t * pc.hc + c) * pc.chunks;
            uint k = lane;
            for (; k + 96u < pc.chunks; k += 128u) {
                a0 += INJ[base + k];
                a1 += INJ[base + k + 32u];
                a2 += INJ[base + k + 64u];
                a3 += INJ[base + k + 96u];
            }
            for (; k < pc.chunks; k += 32u) {
                a0 += INJ[base + k];
            }
            float inj = (a0 + a1) + (a2 + a3);
            [[unroll]] for (uint off = 16u; off > 0u; off >>= 1u) {
                inj += subgroupShuffleXor(inj, off);
            }
            if (lane == 0u) {
                s_w[c] = 2.0 * breccia_sigmoid(inj / float(pc.hc));
            }
        }
    }
    barrier();

    uint d = gl_WorkGroupID.x * 256u + tid;
    if (d >= pc.n_embd) {
        return;
    }
    float block = B[t * pc.n_embd + d];
    for (uint c = 0u; c < pc.hc; ++c) {
        uint idx = (c + pc.hc * t) * pc.n_embd + d;
        O[idx] = R[idx] + block * s_w[c];
    }
}
